---
import SiteLayout from '../layouts/SiteLayout.astro';
import StreamDeck from '../components/StreamDeck.astro';
---

<SiteLayout>
  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot"></span> ELGATO CONTROLS FOR OMARCHY
        </p>
        <div class="hero-wordmark" aria-hidden="true">
          elgato<span>.</span>
        </div>
        <h1>Your Elgato gear, at home on Omarchy.</h1>
        <p class="intro">
          Give your Elgato gear a home on Linux. Buttons, dials, and lights. All
          tuned to the way you work.
        </p>
        <div class="buttons">
          <a class="button primary" href="#setup">
            Get the plugin <span>↗</span>
          </a>
          <a class="button secondary" href="#controls">
            Explore the controls <span>↓</span>
          </a>
        </div>
        <p class="hero-note">
          Open source. MIT licensed. Built for Omarchy Shell.
        </p>
      </div>
      <StreamDeck />
    </section>
    <div class="ticker" aria-label="Capabilities">
      <span>PRESS.</span>
      <span>TURN.</span>
      <span>LIGHT IT UP.</span>
      <span class="ticker-muted">MAKE IT YOURS.</span>
      <span aria-hidden="true">↙</span>
    </div>
    <section id="controls" class="section">
      <div class="section-heading">
        <p class="eyebrow">01 / TAKE CONTROL</p>
        <h2>Less clicking. More doing.</h2>
        <p>
          Keep your favorite actions within reach. Configure everything from the
          Elgato icon in your Omarchy bar.
        </p>
      </div>
      <article class="feature feature-main">
        <div class="feature-copy">
          <p class="eyebrow">STREAM DECK</p>
          <h3>A shortcut to your kind of flow.</h3>
          <p>
            Launch apps, switch workspaces, control audio, and keep your
            everyday actions on a button. Build independent pages and nested
            folders for each device model.
          </p>
          <a
            class="text-link"
            href="https://github.com/dxun-dev/omarchy-elgato/blob/main/docs/usage.md"
          >
            Explore buttons & pages ↗
          </a>
          <div class="tags">
            <span>Custom icons</span>
            <span>State-aware displays</span>
            <span>Pages & folders</span>
          </div>
        </div>
        <figure class="screenshot">
          <div class="window-bar">
            <span>● ● ●</span>
            <span>elgato-controls / buttons</span>
          </div>
          <img
            src={`${import.meta.env.BASE_URL}site-assets/editor.png`}
            alt="Elgato Controls editor showing eight Stream Deck buttons and an action inspector"
            width="768"
            height="588"
            loading="lazy"
          />
        </figure>
      </article>
      <div class="feature-pair">
        <article class="feature feature-small">
          <div class="feature-copy">
            <p class="eyebrow">DIALS & DISPLAYS</p>
            <h3>Dial it in.</h3>
            <p>
              Adjust volume, microphone levels, and lighting. Customize the LCD
              artwork above each dial with icons, text, and colors.
            </p>
            <a
              class="text-link"
              href="https://github.com/dxun-dev/omarchy-elgato/blob/main/docs/usage.md#lcd-display-above-each-dial"
            >
              Explore dial controls ↗
            </a>
          </div>
          <img
            src={`${import.meta.env.BASE_URL}previews/dials.png`}
            alt="Stream Deck dial editor with controls for LCD artwork"
            width="768"
            height="868"
            loading="lazy"
          />
        </article>
        <article class="feature feature-small light-feature">
          <div class="feature-copy">
            <p class="eyebrow">KEY LIGHTS</p>
            <h3>Set the mood.</h3>
            <p>
              Control network Elgato Key Lights from your desktop. Adjust
              brightness and temperature, or bring your lights together with
              grouped actions.
            </p>
            <a
              class="text-link"
              href="https://github.com/dxun-dev/omarchy-elgato/blob/main/README.md"
            >
              Explore light controls ↗
            </a>
          </div>
          <img
            src={`${import.meta.env.BASE_URL}previews/key-lights.png`}
            alt="Elgato Key Light controls for brightness and color temperature"
            width="768"
            height="588"
            loading="lazy"
          />
        </article>
      </div>
    </section>
    <section class="personal section">
      <p class="eyebrow">02 / BUILT TO BE YOURS</p>
      <div class="personal-heading">
        <h2>
          Same hardware. <span class="accent">Entirely your setup.</span>
        </h2>
        <p>
          Your desktop has a personality.
          <br />
          Your controls should, too.
        </p>
      </div>
      <div class="detail-grid">
        <article>
          <span class="detail-number">[01]</span>
          <h3>Make every key yours.</h3>
          <p>
            Bring your own icons, captions, and colors. Give toggles a different
            icon for each action state.
          </p>
        </article>
        <article>
          <span class="detail-number">[02]</span>
          <h3>Go beyond the defaults.</h3>
          <p>
            Add user-installed action packs with their own commands, icons, and
            dependency checks.
          </p>
        </article>
        <article>
          <span class="detail-number">[03]</span>
          <h3>Plan it offline.</h3>
          <p>
            Configure an offline device preview before connecting your hardware.
            Your profiles and custom assets stay yours.
          </p>
        </article>
      </div>
    </section>
    <section id="setup" class="setup section">
      <div>
        <p class="eyebrow">03 / LET’S GET CONNECTED</p>
        <h2>A new home for your gear.</h2>
        <p>
          Start with Omarchy Quattro, Omarchy Shell, and the{' '}
          <code>omarchy plugin</code> commands. Then install and enable:
        </p>
        <div class="command">
          <code id="install-command">
            omarchy plugin add https://github.com/dxun-dev/omarchy-elgato.git
            --enable
          </code>
          <button id="copy" type="button">
            Copy
          </button>
        </div>
        <p
          id="copy-status"
          class="copy-status"
          role="status"
          aria-live="polite"
        ></p>
        <p class="setup-note">
          Choose where to place the widget. On first enable, accept the setup
          prompt for any missing packages and USB access, then open the Elgato
          icon to configure your devices.
        </p>
        <div class="buttons">
          <a
            class="text-link"
            href="https://github.com/dxun-dev/omarchy-elgato#requirements"
          >
            Requirements & installation ↗
          </a>
          <a
            class="text-link"
            href="https://github.com/dxun-dev/omarchy-elgato/blob/main/docs/usage.md"
          >
            Read the guide ↗
          </a>
        </div>
      </div>
      <aside class="setup-aside">
        <span class="terminal-symbol" aria-hidden="true">
          ›_
        </span>
        <p>
          YOUR DESKTOP.
          <br />
          YOUR HARDWARE.
          <br />
          <span class="accent">YOUR CONTROL.</span>
        </p>
        <span class="eyebrow">LINUX / OMARCHY / OPEN SOURCE</span>
      </aside>
    </section>
  </main>
</SiteLayout>
