---
import SiteLayout from '../layouts/SiteLayout.astro';
import StreamDeck from '../components/StreamDeck.astro';
---

<SiteLayout>
  <main id="main">
    <section class="m-auto grid items-center overflow-hidden max-w-375 grid-cols-2 min-h-185 pt-[65px] px-[5%] pb-[70px] max-[1000px]:min-h-[650px] max-[700px]:grid-cols-1 max-[700px]:pt-[50px] max-[700px]:pb-5">
      <div data-reveal-group>
        <p
          data-reveal
          class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] font-mono"
        >
          <span class="inline-block bg-accent w-[7px] h-[7px] rounded-full mr-2 [box-shadow:0_0_12px_color-mix(in_srgb,_var(--accent),_transparent_55%)]"></span>{' '}
          Elgato for Omarchy
        </p>
        <div
          data-reveal
          class="font-mono font-bold text-accent text-[clamp(64px,_7vw,_104px)] leading-[1.05] tracking-[-0.06em] mt-0 mx-0 mb-7 [text-shadow:0_4px_0_color-mix(in_srgb,_var(--accent)_20%,_transparent)]"
          aria-hidden="true"
        >
          elgato<span>.</span>
        </div>
        <h1
          data-reveal
          class="font-mono font-medium text-balance text-[30px] leading-[1.35] tracking-tight mt-0 mx-0 mb-6 max-[700px]:text-[24px]"
        >
          Your Elgato gear, at home on Omarchy.
        </h1>
        <p
          data-reveal
          class="text-muted max-w-[455px] text-[17px] leading-[1.8] max-[700px]:text-[14px]"
        >
          Give your Elgato gear a home on Linux. Buttons, dials, and lights. All
          tuned to the way you work.
        </p>
        <div
          data-reveal
          class="flex items-center flex-wrap gap-5 mt-[30px] max-[700px]:gap-[14px]"
        >
          <a
            class="text-ink no-underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] font-bold inline-flex items-center py-[14px] px-5 text-[12px] gap-[25px] border transition-[transform,background] duration-200 hover:-translate-y-[3px] bg-accent border-accent max-[700px]:text-[11px] max-[700px]:py-3 max-[700px]:px-[14px] max-[700px]:gap-[14px] motion-reduce:transition-none"
            href="#setup"
          >
            Get the plugin <span>↗</span>
          </a>
          <a
            class="text-inherit no-underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] font-bold inline-flex items-center py-[14px] px-5 text-[12px] gap-[25px] border border-line transition-[transform,background] duration-200 hover:-translate-y-[3px] hover:bg-surface max-[700px]:text-[11px] max-[700px]:py-3 max-[700px]:px-[14px] max-[700px]:gap-[14px] motion-reduce:transition-none"
            href="#controls"
          >
            Explore the controls <span>↓</span>
          </a>
        </div>
        <p class="text-muted text-[10px] mt-[25px] font-mono">
          Open source. MIT licensed. Built for Omarchy Shell.
        </p>
      </div>
      <StreamDeck />
    </section>
    <div
      class="flex justify-between font-bold bg-deep gap-5 py-6 px-[5%] border-y border-line text-[clamp(14px,_2.3vw,_30px)] tracking-[-1px] max-[700px]:flex-wrap max-[700px]:gap-[10px] max-[700px]:text-[13px] max-[700px]:py-[18px] font-mono"
      aria-label="Capabilities"
    >
      <span>PRESS.</span>
      <span>TURN.</span>
      <span>LIGHT IT UP.</span>
      <span class="text-accent">MAKE IT YOURS.</span>
      <span class="max-[700px]:hidden" aria-hidden="true">
        ↙
      </span>
    </div>
    <section
      class="m-auto py-25 px-[5%] max-w-375 max-[700px]:py-[65px] max-[700px]:px-[5%]"
      id="controls"
    >
      <div
        data-reveal
        class="grid items-end grid-cols-2 mb-[50px] gap-[0_70px] max-[700px]:grid-cols-1 max-[700px]:gap-[25px]"
      >
        <p class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] col-span-full max-[700px]:mb-0 font-mono">
          01 / TAKE CONTROL
        </p>
        <h2 class="font-semibold text-balance text-[28px] leading-[1.3] tracking-tight m-0 max-[700px]:text-[24px]">
          Less clicking. More doing.
        </h2>
        <p class="text-muted max-w-105 text-[14px] mt-0 mx-0 mb-[6px] max-[700px]:text-[12px]">
          Keep your favorite actions within reach. Configure everything from the
          Elgato icon in your Omarchy bar.
        </p>
      </div>
      <article
        data-reveal
        class="bg-surface overflow-hidden border border-line grid items-center [grid-template-columns:0.85fr_1.15fr] pt-[50px] pr-0 pb-[50px] pl-10 gap-10 max-[1000px]:pt-[30px] max-[1000px]:pr-0 max-[1000px]:pb-[30px] max-[1000px]:pl-[25px] max-[1000px]:gap-[25px] max-[700px]:grid-cols-1 max-[700px]:p-7 max-[700px]:gap-[30px]"
      >
        <div>
          <p class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] font-mono">
            STREAM DECK
          </p>
          <h3 class="font-semibold text-balance text-[28px] leading-[1.3] tracking-tight mt-0 mx-0 mb-5 max-[700px]:text-[24px]">
            A shortcut to your kind of flow.
          </h3>
          <p class="text-muted text-[13px] max-w-[430px]">
            Launch apps, switch workspaces, control audio, and keep your
            everyday actions on a button. Build independent pages and nested
            folders for each device model.
          </p>
          <a
            class="text-inherit underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] hover:text-accent inline-block font-bold text-[11px] mt-[15px] underline-offset-[5px]"
            href={`${import.meta.env.BASE_URL}docs/usage/`}
          >
            Explore buttons & pages ↗
          </a>
          <div class="flex flex-wrap gap-2 mt-[35px] font-mono">
            <span class="text-muted border border-line py-[5px] px-2 text-[9px]">
              Custom icons
            </span>
            <span class="text-muted border border-line py-[5px] px-2 text-[9px]">
              State-aware displays
            </span>
            <span class="text-muted border border-line py-[5px] px-2 text-[9px]">
              Pages & folders
            </span>
          </div>
        </div>
        <figure class="bg-deep mt-0 mr-[-25px] mb-0 ml-0 border border-line [box-shadow:0_16px_40px_#0004] max-[700px]:m-0">
          <div class="flex justify-between text-muted py-[10px] px-[14px] text-[8px] border-b border-line font-mono">
            <span class="text-accent tracking-[3px]">● ● ●</span>
            <span>Omarchy Elgato / buttons</span>
          </div>
          <img
            class="block w-full h-auto"
            src={`${import.meta.env.BASE_URL}site-assets/editor.png`}
            alt="Omarchy Elgato editor showing eight Stream Deck buttons and an action inspector"
            width="768"
            height="588"
            loading="lazy"
          />
        </figure>
      </article>
      <div
        data-reveal-group
        class="grid grid-cols-2 gap-6 mt-6 max-[700px]:grid-cols-1 max-[700px]:gap-5"
      >
        <article
          data-reveal
          class="bg-surface overflow-hidden border border-line pb-0"
        >
          <div class="pt-[35px] px-[35px] pb-[30px] max-[700px]:p-7">
            <p class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] font-mono">
              DIALS & DISPLAYS
            </p>
            <h3 class="font-semibold text-balance text-[28px] leading-[1.3] tracking-tight mt-0 mx-0 mb-5 max-[700px]:text-[24px]">
              Dial it in.
            </h3>
            <p class="text-muted text-[13px] max-w-[430px]">
              Adjust volume, microphone levels, and lighting. Customize the LCD
              artwork above each dial with icons, text, and colors.
            </p>
            <a
              class="text-inherit underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] hover:text-accent inline-block font-bold text-[11px] mt-[15px] underline-offset-[5px]"
              href={`${import.meta.env.BASE_URL}docs/usage/#lcd-display-above-each-dial`}
            >
              Explore dial controls ↗
            </a>
          </div>
          <img
            class="block w-[calc(100%_-_70px)] h-auto mt-0 mx-[35px] mb-[-30px] border border-line [box-shadow:0_10px_30px_#0005] max-[700px]:w-[calc(100%_-_56px)] max-[700px]:mx-7"
            src={`${import.meta.env.BASE_URL}previews/dials.png`}
            alt="Stream Deck dial editor with controls for LCD artwork"
            width="768"
            height="868"
            loading="lazy"
          />
        </article>
        <article
          data-reveal
          class="[background:linear-gradient(_150deg,_var(--surface),_color-mix(in_srgb,_var(--yellow)_8%,_var(--surface))_)] overflow-hidden border border-line pb-0"
        >
          <div class="pt-[35px] px-[35px] pb-[30px] max-[700px]:p-7">
            <p class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] font-mono">
              KEY LIGHTS
            </p>
            <h3 class="font-semibold text-balance text-[28px] leading-[1.3] tracking-tight mt-0 mx-0 mb-5 max-[700px]:text-[24px]">
              Set the mood.
            </h3>
            <p class="text-muted text-[13px] max-w-[430px]">
              Control network Elgato Key Lights from your desktop. Adjust
              brightness and temperature, or bring your lights together with
              grouped actions.
            </p>
            <a
              class="text-inherit underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] hover:text-accent inline-block font-bold text-[11px] mt-[15px] underline-offset-[5px]"
              href={`${import.meta.env.BASE_URL}docs/getting-started/`}
            >
              Explore light controls ↗
            </a>
          </div>
          <img
            class="block w-[calc(100%_-_70px)] h-auto mt-0 mx-[35px] mb-[-30px] border border-line [box-shadow:0_10px_30px_#0005] max-[700px]:w-[calc(100%_-_56px)] max-[700px]:mx-7"
            src={`${import.meta.env.BASE_URL}previews/key-lights.png`}
            alt="Elgato Key Light controls for brightness and color temperature"
            width="768"
            height="588"
            loading="lazy"
          />
        </article>
      </div>
    </section>
    <section class="m-auto py-25 px-[5%] max-w-375 border-t border-line max-[700px]:py-[65px] max-[700px]:px-[5%]">
      <p class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] font-mono">
        02 / BUILT TO BE YOURS
      </p>
      <div
        data-reveal
        class="flex items-end justify-between gap-[30px] max-[700px]:block"
      >
        <h2 class="font-semibold text-balance text-[28px] leading-[1.3] tracking-tight m-0 max-[700px]:text-[24px]">
          Same hardware. <span class="text-accent">Entirely your setup.</span>
        </h2>
        <p class="text-muted text-[13px] max-[700px]:mt-[30px]">
          Your desktop has a personality.
          <br />
          Your controls should, too.
        </p>
      </div>
      <div
        data-reveal-group
        class="grid grid-cols-3 gap-10 mt-15 max-[700px]:grid-cols-1 max-[700px]:gap-[25px] max-[700px]:mt-[35px]"
      >
        <article data-reveal class="border-t border-line pt-[22px]">
          <span class="text-accent text-[11px] font-mono">[01]</span>
          <h3 class="font-medium text-balance text-[18px] leading-[1.3] tracking-tight mt-5 mx-0 mb-[14px]">
            Make every key yours.
          </h3>
          <p class="text-muted text-[12px]">
            Bring your own icons, captions, and colors. Give toggles a different
            icon for each action state.
          </p>
        </article>
        <article data-reveal class="border-t border-line pt-[22px]">
          <span class="text-accent text-[11px] font-mono">[02]</span>
          <h3 class="font-medium text-balance text-[18px] leading-[1.3] tracking-tight mt-5 mx-0 mb-[14px]">
            Go beyond the defaults.
          </h3>
          <p class="text-muted text-[12px]">
            Add user-installed action packs with their own commands, icons, and
            dependency checks.
          </p>
        </article>
        <article data-reveal class="border-t border-line pt-[22px]">
          <span class="text-accent text-[11px] font-mono">[03]</span>
          <h3 class="font-medium text-balance text-[18px] leading-[1.3] tracking-tight mt-5 mx-0 mb-[14px]">
            Plan it offline.
          </h3>
          <p class="text-muted text-[12px]">
            Configure an offline device preview before connecting your hardware.
            Your profiles and custom assets stay yours.
          </p>
        </article>
      </div>
    </section>
    <section
      class="m-auto py-25 px-[5%] max-w-none bg-deep grid [grid-template-columns:1.4fr_0.6fr] gap-[70px] border-y border-line min-[1500px]:px-[calc((100vw_-_1350px)_/_2)] max-[1000px]:gap-[25px] max-[700px]:py-[65px] max-[700px]:px-[5%] max-[700px]:grid-cols-1"
      id="setup"
    >
      <div data-reveal>
        <p class="font-semibold text-accent text-[11px] tracking-[2px] mt-0 mx-0 mb-[26px] font-mono">
          03 / LET’S GET CONNECTED
        </p>
        <h2 class="font-semibold text-balance text-[28px] leading-[1.3] tracking-tight m-0 mb-[30px] max-[700px]:text-[24px]">
          A new home for your gear.
        </h2>
        <p class="text-muted text-[13px] max-w-170">
          Start with Omarchy Quattro, Omarchy Shell, and the{' '}
          <code>omarchy plugin</code> commands. Then install and enable:
        </p>
        <div class="flex items-center bg-background border border-line p-[18px] gap-[18px] max-w-195 mt-7 max-[700px]:p-3 max-[700px]:gap-[10px] font-mono">
          <code
            class="text-accent text-[12px] wrap-anywhere max-[700px]:text-[10px]"
            id="install-command"
          >
            omarchy plugin add https://github.com/dxun-dev/omarchy-elgato.git
            --enable
          </code>
          <button
            class="cursor-pointer touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] ml-auto bg-surface text-foreground py-2 px-3 border border-line text-[11px]"
            id="copy"
            type="button"
          >
            Copy
          </button>
        </div>
        <p
          class="text-muted text-[10px] max-w-170 min-h-5 my-[5px] mx-0"
          id="copy-status"
          role="status"
          aria-live="polite"
        ></p>
        <p class="text-muted text-[11px] max-w-170">
          Choose where to place the widget. On first enable, accept the setup
          prompt for any missing packages and USB access, then open the Elgato
          icon to configure your devices.
        </p>
        <div class="flex items-center flex-wrap gap-5 mt-[30px] max-[700px]:gap-1 max-[700px]:items-start max-[700px]:flex-col">
          <a
            class="text-inherit underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] hover:text-accent inline-block font-bold text-[11px] mt-[15px] underline-offset-[5px]"
            href={`${import.meta.env.BASE_URL}docs/getting-started/#requirements`}
          >
            Requirements & installation ↗
          </a>
          <a
            class="text-inherit underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] hover:text-accent inline-block font-bold text-[11px] mt-[15px] underline-offset-[5px]"
            href={`${import.meta.env.BASE_URL}docs/usage/`}
          >
            Read the guide ↗
          </a>
        </div>
      </div>
      <aside
        data-reveal
        class="self-center border-l border-line p-[35px] text-[10px] max-[1000px]:p-5 max-[700px]:hidden font-mono"
      >
        <span class="text-accent text-[65px]" aria-hidden="true">
          ›_
        </span>
        <p class="text-muted text-[20px] max-w-170 font-bold leading-[1.7] max-[1000px]:text-[16px]">
          YOUR DESKTOP.
          <br />
          YOUR HARDWARE.
          <br />
          <span class="text-accent">YOUR CONTROL.</span>
        </p>
        <span class="font-semibold text-accent text-[8px] tracking-[1px] mt-0 mx-0 mb-[26px] font-mono">
          LINUX / OMARCHY / OPEN SOURCE
        </span>
      </aside>
    </section>
  </main>
</SiteLayout>
