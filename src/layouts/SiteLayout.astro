---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {
  title = 'Omarchy / Elgato',
  description = 'Your Elgato gear, at home on Omarchy. Configure Stream Deck buttons, dials, displays, and Key Lights from your desktop bar.',
} = Astro.props;
---

<!doctype html>
<html
  class="scroll-smooth scroll-pt-[95px] motion-reduce:scroll-auto selection:bg-accent selection:text-ink"
  lang="en"
  data-theme="tokyo"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <title>{title}</title>
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}site-assets/favicon.svg`}
      type="image/svg+xml"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class="bg-background text-foreground font-sans m-0 leading-[1.6]">
    <a
      class="text-ink no-underline touch-manipulation focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[5px] absolute bg-accent left-5 top-[-80px] z-[20] p-3 focus:top-[10px]"
      href="#main"
    >
      Skip to content
    </a>
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
